<?xml version="1.0" encoding="UTF-8"?>
<!--
  Regenerates the gRPC/protobuf Java stubs in ../package from ../src/main/proto with ONE
  protoc / grpc-java version (the checked-in stubs were a mix of protobuf 3.x and 4.31.1 gencode
  and could not be compiled against any single protobuf-java runtime).

      mvn -q -B -f lib/JavaMT4/proto-regen/pom.xml generate-sources

  Keep protoc.version in sync with protobuf.version in ../pom.xml and ../build.gradle
  (gencode 4.x refuses to load on an older runtime).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>pro.mrpc</groupId>
    <artifactId>mt4-proto-regen</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <properties>
        <protoc.version>4.31.1</protoc.version>
        <grpc.version>1.75.0</grpc.version>
    </properties>

    <!-- Only so protoc can import google/protobuf/*.proto and google/api/*.proto (the plugin extracts them from these jars). -->
    <dependencies>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
            <version>${protoc.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.api.grpc</groupId>
            <artifactId>proto-google-common-protos</artifactId>
            <version>2.59.0</version>
        </dependency>
    </dependencies>

    <build>
        <extensions>
            <extension>
                <groupId>kr.motd.maven</groupId>
                <artifactId>os-maven-plugin</artifactId>
                <version>1.7.1</version>
            </extension>
        </extensions>
        <plugins>
            <plugin>
                <groupId>org.xolstice.maven.plugins</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>0.6.1</version>
                <configuration>
                    <protocArtifact>com.google.protobuf:protoc:${protoc.version}:exe:${os.detected.classifier}</protocArtifact>
                    <pluginId>grpc-java</pluginId>
                    <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
                    <protoSourceRoot>${project.basedir}/../src/main/proto</protoSourceRoot>
                    <!-- google/api + google/protobuf come from the dependency jars; only our files go to package/ -->
                    <includes>
                        <include>*.proto</include>
                    </includes>
                    <attachProtoSources>false</attachProtoSources>
                </configuration>
                <executions>
                    <execution>
                        <id>messages</id>
                        <phase>generate-sources</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/../package</outputDirectory>
                            <clearOutputDirectory>true</clearOutputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>grpc</id>
                        <phase>generate-sources</phase>
                        <goals><goal>compile-custom</goal></goals>
                        <configuration>
                            <outputDirectory>${project.basedir}/../package</outputDirectory>
                            <clearOutputDirectory>false</clearOutputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
